{
  "name": "Quick Commerce Reviews",
  "dataColors": ["#1F4E79", "#E4572E", "#2A9D8F", "#8D99AE", "#F2B134", "#6C757D"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F4E79",
  "good": "#2A9D8F",
  "bad": "#E4572E",
  "neutral": "#8D99AE",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2933" },
    "label": { "fontFace": "Segoe UI", "fontSize": 11, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2933" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "fontSize": 14, "fontFamily": "Segoe UI Semibold", "fontColor": { "solid": { "color": "#1F2933" } } }],
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 6 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F7FA" } }, "transparency": 0 }]
      }
    }
  }
}
